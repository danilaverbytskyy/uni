    <!-- contains (содержит) -->
    <owl:ObjectProperty rdf:about="http://example.org/cleaning#contains">
        <rdfs:label xml:lang="ru">содержит</rdfs:label>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/cleaning#FacilityProfile"/>
                    <rdf:Description rdf:about="http://example.org/cleaning#Zoning"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/cleaning#SurfaceMaterials"/>
                    <rdf:Description rdf:about="http://example.org/cleaning#ZoneList"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>

    <!-- has (имеет) -->
    <owl:ObjectProperty rdf:about="http://example.org/cleaning#has">
        <rdfs:label xml:lang="ru">имеет</rdfs:label>
