    <!-- sets (задаёт) -->
    <owl:ObjectProperty rdf:about="http://example.org/cleaning#sets">
        <rdfs:label xml:lang="ru">задаёт</rdfs:label>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/cleaning#Zoning"/>
                    <rdf:Description rdf:about="http://example.org/cleaning#Standard"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/cleaning#ZonePriorities"/>
                    <rdf:Description rdf:about="http://example.org/cleaning#FrequencyNorms"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>

    <!-- binds (привязывает) -->
    <owl:ObjectProperty rdf:about="http://example.org/cleaning#binds">
