    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties with Domain/Range (Step 5)
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- includes (включает) -->
    <owl:ObjectProperty rdf:about="http://example.org/cleaning#includes">
        <rdfs:label xml:lang="ru">включает</rdfs:label>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/cleaning#CleaningManagementSystem"/>
                    <rdf:Description rdf:about="http://example.org/cleaning#TaskList"/>
                    <rdf:Description rdf:about="http://example.org/cleaning#Resource"/>
                    <rdf:Description rdf:about="http://example.org/cleaning#Safety"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/cleaning#Planning"/>
                    <rdf:Description rdf:about="http://example.org/cleaning#CleaningExecution"/>
                    <rdf:Description rdf:about="http://example.org/cleaning#QualityControl"/>

                    <rdf:Description rdf:about="http://example.org/cleaning#DryCleaning"/>
                    <rdf:Description rdf:about="http://example.org/cleaning#WetCleaning"/>
                    <rdf:Description rdf:about="http://example.org/cleaning#Disinfection"/>

                    <rdf:Description rdf:about="http://example.org/cleaning#Staff"/>
                    <rdf:Description rdf:about="http://example.org/cleaning#Equipment"/>
                    <rdf:Description rdf:about="http://example.org/cleaning#Chemicals"/>

                    <rdf:Description rdf:about="http://example.org/cleaning#SIZ"/>
                    <rdf:Description rdf:about="http://example.org/cleaning#Training"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>

    <!-- reliesOn (опирается на) -->
    <owl:ObjectProperty rdf:about="http://example.org/cleaning#reliesOn">
        <rdfs:label xml:lang="ru">опирается на</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/cleaning#CleaningManagementSystem"/>
        <rdfs:range rdf:resource="http://example.org/cleaning#Standard"/>
    </owl:ObjectProperty>

    <!-- manages (управляет) -->
    <owl:ObjectProperty rdf:about="http://example.org/cleaning#manages">
        <rdfs:label xml:lang="ru">управляет</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/cleaning#CleaningManagementSystem"/>
        <rdfs:range rdf:resource="http://example.org/cleaning#Resource"/>
